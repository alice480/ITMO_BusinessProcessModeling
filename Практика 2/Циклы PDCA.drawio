        <mxCell id="QkJQn9wlc1g0zMbGvgE8-28" parent="QkJQn9wlc1g0zMbGvgE8-22" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li data-start=&quot;4072&quot; data-end=&quot;4206&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;b&gt;Продуктовый аналитик сравнивает KPI &quot;до/после&quot; релиза:&lt;/b&gt; конверсия, usage rate, activation, CSAT&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1t723k&quot; data-start=&quot;2057&quot; data-end=&quot;2145&quot;&gt;&lt;p data-start=&quot;2059&quot; data-end=&quot;2145&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b style=&quot;&quot;&gt;Анализируется поведение пользователей&lt;/b&gt; внутри сравнения (на каком шаге теряются) и причины отклонений KPI&lt;/span&gt;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1tadk3y&quot; data-start=&quot;2146&quot; data-end=&quot;2236&quot;&gt;&lt;p data-start=&quot;2148&quot; data-end=&quot;2236&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Сбор обратной связи от операционной команды и клиентов&lt;/b&gt; по удобству и понятности функции&lt;/span&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="300" width="816.5" x="885.75" y="1071" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-29" parent="QkJQn9wlc1g0zMbGvgE8-22" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;Act&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
