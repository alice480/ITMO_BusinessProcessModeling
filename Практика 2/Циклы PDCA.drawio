        <mxCell id="QkJQn9wlc1g0zMbGvgE8-24" parent="QkJQn9wlc1g0zMbGvgE8-22" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 26px;&quot;&gt;&lt;b style=&quot;line-height: 44.2px;&quot;&gt;Продуктовая команда&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 33px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;П&lt;/span&gt;родуктовый менеджер (владелец цели), системные аналитики (требования/сценарии), UX/UI дизайнер (экраны/тексты), разработчики (реализация), QA (проверка), продуктовый аналитик (метрики/отчет)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;OKR:&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;повысить эффективность выбора тура за счет улучшенной функции &quot;Сравнение туров&quot;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;593&quot; data-end=&quot;603&quot; style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;593&quot; data-end=&quot;603&quot; style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SMART-цели периода (=&amp;nbsp;&lt;/strong&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;2 недели - 1 спринт):&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ol style=&quot;line-height: 12px;&quot;&gt;&lt;li data-section-id=&quot;rbgvrl&quot; data-start=&quot;566&quot; data-end=&quot;634&quot;&gt;&lt;p data-start=&quot;569&quot; data-end=&quot;634&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 120%;&quot;&gt;увеличить конверсию &quot;выбор→оформление&quot; еще на &lt;strong data-start=&quot;2993&quot; data-end=&quot;2999&quot;&gt;A%&lt;/strong&gt; относительно итерации 1;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-section-id=&quot;rbgvrl&quot; data-start=&quot;566&quot; data-end=&quot;634&quot;&gt;&lt;p data-start=&quot;569&quot; data-end=&quot;634&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;увеличить долю пользователей, использующих сравнение, до &lt;strong data-start=&quot;3087&quot; data-end=&quot;3093&quot; style=&quot;&quot;&gt;B%&lt;/strong&gt;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-section-id=&quot;rbgvrl&quot; data-start=&quot;566&quot; data-end=&quot;634&quot;&gt;&lt;p data-start=&quot;569&quot; data-end=&quot;634&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;повысить CSAT по удобству выбора тура до &lt;strong data-start=&quot;1932&quot; data-end=&quot;1937&quot; style=&quot;&quot;&gt;C&lt;/strong&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;KPI итерации 2&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px;&quot;&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;li data-section-id=&quot;oo9r9f&quot; data-start=&quot;842&quot; data-end=&quot;889&quot;&gt;&lt;p data-start=&quot;844&quot; data-end=&quot;889&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 22px;&quot;&gt;конверсия &quot;выбор тура → оформление заказа&quot;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;li data-section-id=&quot;x0bz9f&quot; data-start=&quot;890&quot; data-end=&quot;959&quot;&gt;&lt;p data-start=&quot;892&quot; data-end=&quot;959&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 22px;&quot;&gt;доля пользователей выдачи, использующих &quot;Сравнение&quot; (usage rate);&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;li data-section-id=&quot;1l9a0nw&quot; data-start=&quot;960&quot; data-end=&quot;1048&quot;&gt;&lt;p data-start=&quot;962&quot; data-end=&quot;1048&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 22px;&quot;&gt;доля пользователей, дошедших до экрана сравнения после добавления тура (activation);&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;li data-section-id=&quot;14qwzat&quot; data-start=&quot;1049&quot; data-end=&quot;1131&quot;&gt;&lt;p data-start=&quot;1051&quot; data-end=&quot;1131&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 22px;&quot;&gt;CSAT/оценка удобства выбора тура.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;strong data-start=&quot;833&quot; data-end=&quot;855&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 22px;&quot;&gt;Способ выполнения&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Рели&lt;/font&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;з &quot;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Сравнение 2.0&quot; (расширение сравниваемых параметров + улучшение интерфейса/навигации) + оценка эффекта по KPI &quot;до/после&quot; + регресс-тест&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="710" width="830" x="20" y="140" as="geometry" />
        </mxCell>
