        <mxCell id="QkJQn9wlc1g0zMbGvgE8-14" parent="QkJQn9wlc1g0zMbGvgE8-13" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Plan&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="860" width="860" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-15" parent="QkJQn9wlc1g0zMbGvgE8-13" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 26px;&quot;&gt;&lt;b style=&quot;line-height: 170%;&quot;&gt;Продуктовая команда&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 150%;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;П&lt;/span&gt;родуктовый менеджер (владелец цели), системные аналитики (требования/сценарии), UX/UI дизайнер (экраны/тексты), разработчики (реализация), QA (проверка), продуктовый аналитик (метрики/отчет)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;OKR:&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;повысить конверсию выбора тура за счет запуска новой продуктовой функции &quot;Сравнение туров&quot;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;593&quot; data-end=&quot;603&quot; style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;593&quot; data-end=&quot;603&quot; style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SMART-цели периода (=&amp;nbsp;&lt;/strong&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;2 недели - 1 спринт):&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ol style=&quot;line-height: 100%;&quot;&gt;&lt;li data-section-id=&quot;rbgvrl&quot; data-start=&quot;566&quot; data-end=&quot;634&quot;&gt;&lt;p data-start=&quot;569&quot; data-end=&quot;634&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 100%;&quot;&gt;увеличить конверсию &quot;выбор тура → оформление заказа&quot; на &lt;strong data-start=&quot;625&quot; data-end=&quot;631&quot;&gt;X%&lt;/strong&gt;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-section-id=&quot;rbgvrl&quot; data-start=&quot;566&quot; data-end=&quot;634&quot;&gt;&lt;p data-start=&quot;569&quot; data-end=&quot;634&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 100%;&quot;&gt;обеспечить долю использования функции &quot;Сравнение&quot; не ниже &lt;/span&gt;&lt;strong data-start=&quot;698&quot; data-end=&quot;704&quot; style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 100%;&quot;&gt;Y%&lt;/strong&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 100%;&quot;&gt; среди пользователей выдачи;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-section-id=&quot;rbgvrl&quot; data-start=&quot;566&quot; data-end=&quot;634&quot;&gt;&lt;p data-start=&quot;569&quot; data-end=&quot;634&quot;&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;удержать CSAT по удобству выбора тура не ниже &lt;/span&gt;&lt;strong data-start=&quot;786&quot; data-end=&quot;791&quot; style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Z&lt;/strong&gt;&lt;span style=&quot;font-size: 22px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;KPI итерации 1&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;li data-section-id=&quot;oo9r9f&quot; data-start=&quot;842&quot; data-end=&quot;889&quot;&gt;&lt;p data-start=&quot;844&quot; data-end=&quot;889&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 100%;&quot;&gt;конверсия &quot;выбор тура → оформление заказа&quot;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;li data-section-id=&quot;x0bz9f&quot; data-start=&quot;890&quot; data-end=&quot;959&quot;&gt;&lt;p data-start=&quot;892&quot; data-end=&quot;959&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 100%;&quot;&gt;доля пользователей выдачи, использующих &quot;Сравнение&quot; (usage rate);&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;li data-section-id=&quot;1l9a0nw&quot; data-start=&quot;960&quot; data-end=&quot;1048&quot;&gt;&lt;p data-start=&quot;962&quot; data-end=&quot;1048&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 100%;&quot;&gt;доля пользователей, дошедших до экрана сравнения после добавления тура (activation);&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;li data-section-id=&quot;14qwzat&quot; data-start=&quot;1049&quot; data-end=&quot;1131&quot;&gt;&lt;p data-start=&quot;1051&quot; data-end=&quot;1131&quot;&gt;&lt;font style=&quot;font-size: 22px; line-height: 100%;&quot;&gt;CSAT/оценка удобства выбора тура (опрос/оценка в обращениях, если используется).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;strong data-start=&quot;833&quot; data-end=&quot;855&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 22px;&quot;&gt;Способ выполнения&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Релиз MVP &quot;Сравнение туров&quot; + настройка продуктовой аналитики (события/воронки/дашборд &quot;до/после&quot;) + критерии приемки и регресс-тест&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="729" width="830" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-16" parent="QkJQn9wlc1g0zMbGvgE8-13" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;Do&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="860" width="860" x="864" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-17" parent="QkJQn9wlc1g0zMbGvgE8-13" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li data-start=&quot;58&quot; data-end=&quot;196&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;b&gt;Системные аналитики&lt;/b&gt; описывают требования и критерии приемки для MVP (что сравниваем, ограничения по количеству туров, где хранится список сравнения)&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li data-start=&quot;1502&quot; data-end=&quot;1630&quot;&gt;&lt;p data-start=&quot;1504&quot; data-end=&quot;1630&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;UX/UI дизайнер&lt;/b&gt; проектирует экраны/элементы управления сравнения и тексты&lt;/span&gt;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1631&quot; data-end=&quot;1904&quot;&gt;&lt;p data-start=&quot;1633&quot; data-end=&quot;1904&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;b&gt;Разработчики&lt;/b&gt; реализуют функциональность (кнопки &quot;добавить в сравнение&quot;, экран сравнения, сохранение выбора);&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1631&quot; data-end=&quot;1904&quot;&gt;&lt;p data-start=&quot;1633&quot; data-end=&quot;1904&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;b&gt;QA&lt;/b&gt; выполняет функциональное тестирование и регресс ключевых сценариев.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1631&quot; data-end=&quot;1904&quot;&gt;&lt;p data-start=&quot;1633&quot; data-end=&quot;1904&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;b&gt;Продуктовый аналитик&lt;/b&gt; настраивает события и дашборд (использование, конверсия, путь пользователя).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="600" width="833" x="882.75" y="174" as="geometry" />
