        <mxCell id="QkJQn9wlc1g0zMbGvgE8-2" parent="QkJQn9wlc1g0zMbGvgE8-1" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;container=0;" value="&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Plan&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(128, 128, 128); font-size: 70px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="860" width="860" x="1" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-3" parent="QkJQn9wlc1g0zMbGvgE8-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=0;" value="&lt;font style=&quot;font-size: 26px;&quot;&gt;&lt;b&gt;Операционная команда: поддержка + бронирование&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Объект работы&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;Обращения клиентов по оформлению/оплате/статусу; заказы со статусами &quot;не подтвержден&quot;, &quot;завис&quot;, &quot;одобрен, но документов нет&quot;.&lt;/font&gt;&lt;/font&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;SMART цели периода (= 1 неделя)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;ol data-start=&quot;234&quot; data-end=&quot;519&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;снизить &lt;/span&gt;&lt;span data-start=&quot;516&quot; data-end=&quot;545&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;MTTR по инцидентам заказа&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; до 6&lt;/span&gt;&lt;em data-start=&quot;549&quot; data-end=&quot;558&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;часов&lt;/em&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li data-start=&quot;562&quot; data-end=&quot;641&quot;&gt;&lt;p data-start=&quot;565&quot; data-end=&quot;641&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 24px;&quot;&gt;обеспечить &lt;span data-start=&quot;576&quot; data-end=&quot;625&quot;&gt;SLA восстановления/выдачи документов при сбое&lt;/span&gt; не ниже 95&lt;em data-start=&quot;634&quot; data-end=&quot;638&quot;&gt;%&lt;/em&gt;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;642&quot; data-end=&quot;707&quot;&gt;&lt;p data-start=&quot;645&quot; data-end=&quot;707&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 24px;&quot;&gt;удерживать &lt;span data-start=&quot;656&quot; data-end=&quot;663&quot;&gt;FRT&lt;/span&gt; не выше 15&lt;em data-start=&quot;672&quot; data-end=&quot;681&quot;&gt;&amp;nbsp;минут&lt;/em&gt; и &lt;span data-start=&quot;684&quot; data-end=&quot;692&quot;&gt;CSAT&lt;/span&gt; не ниже &lt;i&gt;4.6 из 5&lt;/i&gt;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;708&quot; data-end=&quot;792&quot;&gt;&lt;p data-start=&quot;711&quot; data-end=&quot;792&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 24px;&quot;&gt;снизить &lt;span data-start=&quot;719&quot; data-end=&quot;747&quot; style=&quot;&quot;&gt;долю повторных обращений&lt;/span&gt; по теме &quot;статус/документы/оплата&quot; до 10&lt;em data-start=&quot;785&quot; data-end=&quot;789&quot; style=&quot;&quot;&gt;%&lt;/em&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;line-height: 150%; font-size: 24px;&quot;&gt;KPI&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;MTTR; SLA восстановления/выдачи документов при сбое; FRT; CSAT; доля повторных обращений&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;974&quot; data-end=&quot;996&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Способ выполнения&lt;/font&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Регламент обработки обращений и исключений + матрица эскалаций (туроператор/финансы/разработка) + шаблоны уведомлений/чек-листы.&lt;br data-start=&quot;1125&quot; data-end=&quot;1128&quot;&gt;&lt;br&gt;&lt;strong data-start=&quot;1128&quot; data-end=&quot;1140&quot; style=&quot;&quot;&gt;Ресурсы:&lt;/strong&gt; смены, доступы к статусам заказа/документам/каналам связи с туроператорами&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="650" width="830" x="20" y="150" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-4" parent="QkJQn9wlc1g0zMbGvgE8-1" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;container=0;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;Do&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="860" width="860" x="864" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-5" parent="QkJQn9wlc1g0zMbGvgE8-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=0;" value="&lt;li data-start=&quot;58&quot; data-end=&quot;196&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;&lt;strong data-start=&quot;37&quot; data-end=&quot;61&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Специалист поддержки&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; принимает обращение, фиксирует контекст (id заказа/статус/ошибка), классифицирует кейс и направляет в нужную очередь;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li data-start=&quot;182&quot; data-end=&quot;304&quot;&gt;&lt;p data-start=&quot;184&quot; data-end=&quot;304&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;&lt;strong data-start=&quot;184&quot; data-end=&quot;217&quot;&gt;Руководитель службы поддержки&lt;/strong&gt; контролирует SLA по ответам, распределяет нагрузку и приоритизирует кейсы &quot;вне SLA&quot;;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;305&quot; data-end=&quot;476&quot;&gt;&lt;p data-start=&quot;307&quot; data-end=&quot;476&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;&lt;strong data-start=&quot;307&quot; data-end=&quot;337&quot;&gt;Специалист по бронированию&lt;/strong&gt; обрабатывает исключения: уточняет причину (при необходимости связывается с туроператором), переводит заказ в корректный итоговый статус;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;477&quot; data-end=&quot;627&quot;&gt;&lt;p data-start=&quot;479&quot; data-end=&quot;627&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;&lt;strong data-start=&quot;479&quot; data-end=&quot;507&quot;&gt;Руководитель back-office&lt;/strong&gt; контролирует очередь исключений, назначает ответственных, эскалирует в туроператора/финансы/разработку по регламенту.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;628&quot; data-end=&quot;785&quot;&gt;&lt;p data-start=&quot;630&quot; data-end=&quot;785&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;&lt;strong data-start=&quot;630&quot; data-end=&quot;660&quot;&gt;Специалист по бронированию&lt;/strong&gt; восстанавливает выдачу документов при сбое (перегенерация/публикация; при необходимости — формирование и отправка пакета);&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;786&quot; data-end=&quot;882&quot; data-is-last-node=&quot;&quot;&gt;&lt;p data-start=&quot;788&quot; data-end=&quot;882&quot; data-is-last-node=&quot;&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;&lt;strong data-start=&quot;788&quot; data-end=&quot;812&quot; style=&quot;&quot;&gt;Специалист поддержки&lt;/strong&gt; уведомляет клиента о результате/следующем шаге и закрывает обращение.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="610" width="799" x="891" y="196.5" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-6" parent="QkJQn9wlc1g0zMbGvgE8-1" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;container=0;" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(128, 128, 128), rgb(127, 127, 127)); font-size: 70px; background-color: transparent;&quot;&gt;Check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;span style=&quot;font-size: 70px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="860" width="860" x="864" y="863" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-7" parent="QkJQn9wlc1g0zMbGvgE8-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=0;" value="&lt;li data-start=&quot;762&quot; data-end=&quot;931&quot;&gt;&lt;p data-start=&quot;764&quot; data-end=&quot;931&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Ежедневно контролируются KPI:&lt;/b&gt; &lt;span data-start=&quot;806&quot; data-end=&quot;828&quot; style=&quot;&quot;&gt;MTTR по инцидентам&lt;/span&gt;, &lt;span data-start=&quot;830&quot; data-end=&quot;879&quot; style=&quot;&quot;&gt;SLA восстановления/выдачи документов при сбое&lt;/span&gt;, &lt;span data-start=&quot;881&quot; data-end=&quot;888&quot; style=&quot;&quot;&gt;FRT&lt;/span&gt;, &lt;span data-start=&quot;890&quot; data-end=&quot;898&quot; style=&quot;&quot;&gt;CSAT&lt;/span&gt;, &lt;span data-start=&quot;900&quot; data-end=&quot;928&quot; style=&quot;&quot;&gt;доля повторных обращений;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;932&quot; data-end=&quot;1092&quot;&gt;&lt;p data-start=&quot;934&quot; data-end=&quot;1092&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;b&gt;Проводится выборочная проверка кейсов: &lt;/b&gt;корректность статуса заказа, наличие причины отказа, корректность отправленных документов, качество ответа поддержки;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1093&quot; data-end=&quot;1228&quot;&gt;&lt;p data-start=&quot;1095&quot; data-end=&quot;1228&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;Анализируются &quot;топ-причины&quot; инцидентов:&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;по туроператорам, по оплате, по документам; фиксируются повторяющиеся сценарии и узкие места;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1093&quot; data-end=&quot;1228&quot;&gt;&lt;p data-start=&quot;1095&quot; data-end=&quot;1228&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;b&gt;Собирается обратная связь:&lt;/b&gt; от клиентов (оценки/жалобы) и от команды (что мешает, где нет инструментов/инструкций)&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="543.5" width="804.25" x="905.38" y="1086.5" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-8" parent="QkJQn9wlc1g0zMbGvgE8-1" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;container=0;" value="&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;Act&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 70px;&quot;&gt;&lt;font color=&quot;#808080&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="860" width="860" y="863" as="geometry" />
        </mxCell>
        <mxCell id="QkJQn9wlc1g0zMbGvgE8-9" parent="QkJQn9wlc1g0zMbGvgE8-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=0;" value="&lt;li data-start=&quot;1240&quot; data-end=&quot;1371&quot;&gt;&lt;p data-start=&quot;1242&quot; data-end=&quot;1371&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;strong data-start=&quot;2800&quot; data-end=&quot;2830&quot; style=&quot;&quot;&gt;Систематические улучшения:&lt;/strong&gt; обновление чек-листов и шаблонов, корректировка правил эскалации и приоритетов очередей, обучение по типовым кейсам, уточнение справочника причин отказа;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1240&quot; data-end=&quot;1371&quot;&gt;&lt;p data-start=&quot;1242&quot; data-end=&quot;1371&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;strong data-start=&quot;2988&quot; data-end=&quot;3021&quot;&gt;Ad hoc (если KPI ухудшаются):&lt;/strong&gt; усиление смены, отдельная приоритетная очередь, временный ручной сценарий выдачи документов, выпуск срочного уведомления клиентам о задержках, эскалация в разработку/финансы/партнерства;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1240&quot; data-end=&quot;1371&quot;&gt;&lt;p data-start=&quot;1242&quot; data-end=&quot;1371&quot;&gt;&lt;font style=&quot;font-size: 32px;&quot;&gt;&lt;strong data-start=&quot;3212&quot; data-end=&quot;3233&quot; style=&quot;&quot;&gt;Контроль эффекта:&lt;/strong&gt; продуктовый/операционный аналитический отчет &amp;quot;до/после&amp;quot; по KPI, срок проверки эффекта &lt;em data-start=&quot;3320&quot; data-end=&quot;3336&quot; style=&quot;&quot;&gt;через 1 неделю&lt;/em&gt;, закрепление изменений как стандарта или откат/перепланирование.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="593.5" width="830" x="30" y="1026.5" as="geometry" />
        </mxCell>
